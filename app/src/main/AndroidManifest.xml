<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only network permission the app needs: reaching the Learning Mocha backend gateway
         (DeepSeek proxy). Every other feature works fully offline, and offline handling is done
         by pinging the gateway rather than by reading connectivity state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local reminder notification for backup; requested at runtime on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LearningMochaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearningMocha">
        <!-- allowBackup is off on purpose: Android Auto Backup would copy the Room database,
             chat history included, to the user's cloud account, and the app promises that
             nothing leaves the device (settings_privacy_body). Settings -> Export library is
             the supported backup path, and it deliberately omits chat. -->

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
