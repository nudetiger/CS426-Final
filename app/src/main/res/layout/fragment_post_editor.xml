<?xml version="1.0" encoding="utf-8"?>
<!-- Two tabs, not one scrolling column: Details holds everything about the post, Source holds
     the post itself. Splitting them is what lets the writing area own the whole screen, which
     is the only way editing long Markdown on a phone is bearable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/editor_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/editor_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_title"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editor_preview_toggle"
            style="@style/Widget.Mocha.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_tab_preview"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editor_save"
            style="@style/Widget.Mocha.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_save" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/editor_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        app:tabIndicatorColor="?attr/mochaBrown"
        app:tabSelectedTextColor="?attr/mochaBrown"
        app:tabTextAppearance="@style/TextAppearance.Mocha.Caption"
        app:tabTextColor="?attr/mochaTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_tab_details" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_tab_source" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/editor_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Tab 1: everything about the post. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/editor_details_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_l">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editor_title_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:hint="@string/editor_title_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editor_title_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:text="@string/editor_section_status"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/editor_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginEnd="@dimen/content_gutter"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/editor_status_none"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/status_none" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/editor_status_reading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/status_reading" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/editor_status_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/status_in_progress" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/editor_status_finished"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/status_finished" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:text="@string/editor_section_tags"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editor_tags_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:hint="@string/editor_tags_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editor_tags_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_resources_header"
                            android:textAppearance="@style/TextAppearance.Mocha.Section" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_add_resource"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_resources_add" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/editor_resources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/editor_resources_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:text="@string/editor_resources_empty"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginTop="@dimen/space_m"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:text="@string/editor_section_terms"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editor_term"
                        style="@style/Widget.Mocha.ToolbarButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/editor_term_add" />

                    <TextView
                        android:id="@+id/editor_terms_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/content_gutter"
                        android:layout_marginEnd="@dimen/content_gutter"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Tab 2: the Markdown, and nothing else competing for the height. -->
            <LinearLayout
                android:id="@+id/editor_source_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/mochaCreamDark"
                    android:paddingStart="@dimen/space_s"
                    android:paddingEnd="@dimen/space_s"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_bold"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_italic"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_italic" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_format_heading"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_heading" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_list"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_list" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_link"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_link" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editor_wikilink"
                            style="@style/Widget.Mocha.ToolbarButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_format_wikilink" />
                    </LinearLayout>
                </HorizontalScrollView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/editor_body"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/mochaSurface"
                        android:gravity="top|start"
                        android:hint="@string/editor_body_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="@dimen/space_m"
                        android:scrollbars="vertical"
                        android:textAppearance="@style/TextAppearance.Mocha.Code"
                        android:textColor="?attr/mochaTextPrimary"
                        android:textColorHint="?attr/mochaTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/editor_preview_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/mochaSurface"
                        android:paddingStart="@dimen/content_gutter"
                        android:paddingTop="@dimen/space_m"
                        android:paddingEnd="@dimen/content_gutter"
                        android:paddingBottom="@dimen/space_m"
                        android:visibility="gone">

                        <!-- wrap_content, not match_parent: a TextView only applies maxWidth
                             when it is measured AT_MOST, which is what keeps the preview column
                             readable on a tablet. Aligned to the start, not centred — prose
                             that floats in the middle of the page reads as a caption. -->
                        <TextView
                            android:id="@+id/editor_preview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:maxWidth="@dimen/reader_max_width"
                            android:textAppearance="@style/TextAppearance.Mocha.Body" />
                    </androidx.core.widget.NestedScrollView>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
