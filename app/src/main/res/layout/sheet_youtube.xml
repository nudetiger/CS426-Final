<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mocha_cream"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <TextView
        android:id="@+id/youtube_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Mocha.Title"
        android:textColor="@color/mocha_brown" />

    <!-- The height is not really wrap_content: YouTubePlayerSheet.keepSixteenByNine measures
         it to 16:9 of the sheet width on every layout, which is why the embed cannot collapse
         the way WebViewLayout warns about. -->
    <WebView
        android:id="@+id/youtube_sheet_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:background="@color/mocha_cream_dark"
        tools:ignore="WebViewLayout" />

    <TextView
        android:id="@+id/youtube_sheet_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/youtube_sheet_unavailable"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/youtube_sheet_open"
        style="@style/Widget.Mocha.ToolbarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/youtube_sheet_open" />
</LinearLayout>
