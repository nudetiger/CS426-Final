<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_l">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/editor_resource_dialog_title"
        android:textAppearance="@style/TextAppearance.Mocha.Title"
        android:textColor="?attr/mochaBrown" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/editor_resource_kind"
        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

    <RadioGroup
        android:id="@+id/resource_kind_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/resource_kind_article"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/resource_kind_article"
            android:textAppearance="@style/TextAppearance.Mocha.Body" />

        <RadioButton
            android:id="@+id/resource_kind_youtube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resource_kind_youtube"
            android:textAppearance="@style/TextAppearance.Mocha.Body" />

        <RadioButton
            android:id="@+id/resource_kind_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resource_kind_book"
            android:textAppearance="@style/TextAppearance.Mocha.Body" />

        <RadioButton
            android:id="@+id/resource_kind_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resource_kind_other"
            android:textAppearance="@style/TextAppearance.Mocha.Body" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/editor_resource_url_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resource_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/editor_resource_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resource_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
