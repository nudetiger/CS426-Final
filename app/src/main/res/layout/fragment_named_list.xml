<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/named_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/named_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <EditText
        android:id="@+id/named_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_gutter"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/content_gutter"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_card"
        android:hint="@string/dictionary_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="@dimen/touch_target"
        android:padding="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Mocha.Body"
        android:textColorHint="?attr/mochaTextSecondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/named_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_gutter"
        android:paddingEnd="@dimen/content_gutter"
        android:paddingBottom="@dimen/space_s"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            android:id="@+id/named_chip_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/dictionary_scope_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/named_chip_global"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/dictionary_scope_global" />

        <com.google.android.material.chip.Chip
            android:id="@+id/named_chip_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/dictionary_scope_post" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/named_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/content_gutter"
            android:paddingEnd="@dimen/content_gutter" />

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
