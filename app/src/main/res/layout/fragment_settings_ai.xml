<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_island"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter">

        <ImageButton
            android:id="@+id/ai_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_backend"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_backend_address"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/settings_backend_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/settings_backend_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="?attr/mochaTextSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_save"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_reset"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_test"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_test" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_backend_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_backend_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_assistant"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_suggest_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/settings_suggest_mode"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_suggest_mode_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
