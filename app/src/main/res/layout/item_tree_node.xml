<?xml version="1.0" encoding="utf-8"?>
<!-- One Browse row. The leading rail and the icon are tinted at bind time — by learning
     status for a post, by type for a branch or folder — so the row is readable as a colour
     before it is read as text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/node_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/zebra_row_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s"
    android:paddingEnd="@dimen/space_xs">

    <View
        android:id="@+id/node_accent"
        android:layout_width="@dimen/accent_bar_width"
        android:layout_height="@dimen/icon_list"
        android:background="@drawable/bg_accent_bar" />

    <ImageView
        android:id="@+id/node_icon"
        android:layout_width="@dimen/icon_list"
        android:layout_height="@dimen/icon_list"
        android:layout_marginStart="@dimen/space_xs"
        android:contentDescription="@string/cd_folder"
        android:padding="@dimen/space_s"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/node_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/node_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="@dimen/space_s"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="2dp"
                android:textAppearance="@style/TextAppearance.Mocha.Caption"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/node_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/node_children"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/browse_open_children"
        android:padding="@dimen/space_s"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/node_favorite"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_favorite"
        android:src="@drawable/ic_star_border" />

    <ImageButton
        android:id="@+id/node_menu"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more" />
</LinearLayout>
