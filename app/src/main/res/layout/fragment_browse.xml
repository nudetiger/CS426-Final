<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mocha_header_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s">

            <TextView
                android:id="@+id/browse_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Mocha.Title"
                android:textColor="@color/mocha_brown" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/browse_breadcrumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browse_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_s"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/fab_list_inset" />

            <include
                android:id="@+id/list_state"
                layout="@layout/view_list_state" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/browse_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/cd_add"
        app:backgroundTint="@color/mocha_brown"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/mocha_on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
