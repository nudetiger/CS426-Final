<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_island"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_s">

            <TextView
                android:id="@+id/browse_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Mocha.Title"
                android:textColor="?attr/mochaBrown" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/browse_breadcrumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- What this folder holds, before the list of what is directly in it: the meter
                 answers "how far through am I" without opening a single post. -->
            <include
                android:id="@+id/browse_meter"
                layout="@layout/view_status_meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/mochaCreamDark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browse_sort"
                style="@style/Widget.Mocha.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_sort"
                app:icon="@drawable/ic_sort"
                app:iconTint="?attr/mochaBrown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browse_filter"
                style="@style/Widget.Mocha.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_filter"
                app:icon="@drawable/ic_filter"
                app:iconTint="?attr/mochaBrown" />

            <TextView
                android:id="@+id/browse_filter_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Mocha.Caption"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browse_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/content_gutter"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/content_gutter"
                android:paddingBottom="@dimen/fab_list_inset" />

            <include
                android:id="@+id/list_state"
                layout="@layout/view_list_state" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/browse_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/cd_add"
        app:backgroundTint="?attr/mochaBrown"
        app:srcCompat="@drawable/ic_add"
        app:tint="?attr/mochaOnPrimary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
