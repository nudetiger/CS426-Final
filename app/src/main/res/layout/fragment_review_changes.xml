<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter">

        <ImageButton
            android:id="@+id/review_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/review_title"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <TextView
        android:id="@+id/review_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/content_gutter"
        android:textAppearance="@style/TextAppearance.Mocha.Section" />

    <TextView
        android:id="@+id/review_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter"
        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

    <TextView
        android:id="@+id/review_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter"
        android:text="@string/review_delete_warning"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="?attr/mochaError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/review_errors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/content_gutter"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="?attr/mochaError"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/review_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/content_gutter"
            android:paddingEnd="@dimen/content_gutter" />

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:orientation="horizontal"
        android:padding="@dimen/space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_discard"
            style="@style/Widget.Mocha.ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/review_discard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/review_apply" />
    </LinearLayout>
</LinearLayout>
