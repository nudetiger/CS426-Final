<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/zebra_row_min"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <CheckBox
        android:id="@+id/review_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/touch_target"
        android:minHeight="@dimen/touch_target" />

    <ImageView
        android:id="@+id/review_row_icon"
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:contentDescription="@null"
        android:src="@drawable/ic_post" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_xs">

        <TextView
            android:id="@+id/review_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mocha.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_row_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mocha.Caption" />

        <TextView
            android:id="@+id/review_row_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mocha.Caption"
            android:textColor="@color/mocha_error"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/review_row_menu"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more" />
</LinearLayout>
