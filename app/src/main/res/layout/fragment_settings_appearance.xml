<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter">

        <ImageButton
            android:id="@+id/appearance_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_appearance"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <!-- Two columns of @layout/item_theme_card, filled by AppearanceSettingsFragment
                 from the AppTheme entries. A GridLayout rather than a RecyclerView: the list
                 is an enum that never changes length, and a RecyclerView inside this
                 ScrollView would only add a scroll conflict to solve. -->
            <GridLayout
                android:id="@+id/settings_theme_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:columnCount="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_reading"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <!-- A live sample rather than a number: nobody knows what 1.15x line spacing
                 looks like, and the whole point of the control is how it reads. -->
            <TextView
                android:id="@+id/settings_reading_sample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:text="@string/settings_reading_sample"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <TextView
                android:id="@+id/settings_text_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_text_size"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <com.google.android.material.slider.Slider
                android:id="@+id/settings_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_text_size"
                android:stepSize="0.05"
                android:value="1.0"
                android:valueFrom="0.85"
                android:valueTo="1.4" />

            <TextView
                android:id="@+id/settings_line_spacing_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_line_spacing"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <com.google.android.material.slider.Slider
                android:id="@+id/settings_line_spacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_line_spacing"
                android:stepSize="0.1"
                android:value="1.5"
                android:valueFrom="1.0"
                android:valueTo="2.2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_reading_reset"
                style="@style/Widget.Mocha.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_reading_reset" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_lists"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_colorful"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/settings_colorful"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_colorful_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
