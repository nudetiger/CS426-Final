<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/conversation_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/conversation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:scrollbars="none">

        <!-- Multi-select: the three action modes combine, and picking any of them clears
             Answer. The fragment enforces that, because a ChipGroup cannot express it. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/conversation_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chat_mode_answer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_suggest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_mode_suggest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_modify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_mode_modify" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_organize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_mode_organize" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/conversation_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaCreamDark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_s"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/chat_offline"
            android:textAppearance="@style/TextAppearance.Mocha.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/conversation_banner_retry"
            style="@style/Widget.Mocha.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_retry" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversation_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_s" />

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/conversation_sending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="?attr/mochaBrown"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <EditText
            android:id="@+id/conversation_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:hint="@string/chat_input_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="@dimen/touch_target"
            android:padding="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Mocha.Body"
            android:textColorHint="?attr/mochaTextSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/conversation_send"
            style="@style/Widget.Mocha.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_send" />
    </LinearLayout>
</LinearLayout>
