<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant bubble hugs the start edge, so only the end side carries a gutter.
     Start/End keep that correct in RTL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/chat_bubble_gutter"
    android:paddingBottom="@dimen/space_xs"
    tools:ignore="RtlSymmetry">


    <!-- Which mode this exchange was sent in. Tinted at bind time, so scrolling back through
         a conversation shows what each turn was asking for without reading a word of it. -->
    <TextView
        android:id="@+id/bubble_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_assistant"
        android:maxWidth="@dimen/chat_bubble_max"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Mocha.Body"
        android:textColor="?attr/mochaTextPrimary" />

    <TextView
        android:id="@+id/bubble_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="?attr/mochaTextSecondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubble_context"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="?attr/mochaTextSecondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubble_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="?attr/mochaBrown"
        android:visibility="gone" />
</LinearLayout>
