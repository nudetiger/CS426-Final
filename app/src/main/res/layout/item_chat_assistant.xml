<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/chat_bubble_gutter"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_assistant"
        android:maxWidth="@dimen/chat_bubble_max"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Mocha.Body"
        android:textColor="@color/mocha_text_primary" />

    <TextView
        android:id="@+id/bubble_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="@color/mocha_text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubble_context"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="@color/mocha_text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubble_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textColor="@color/mocha_brown"
        android:visibility="gone" />
</LinearLayout>
