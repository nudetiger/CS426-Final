<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_island"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter">

        <ImageButton
            android:id="@+id/profile_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_you"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_you_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_profile_name"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/settings_profile_name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="?attr/mochaTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_profile_birth"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <TextView
                android:id="@+id/profile_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:text="@string/settings_profile_birth_unset"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_profile_gender"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <RadioGroup
                android:id="@+id/profile_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <RadioButton
                    android:id="@+id/profile_gender_male"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_male" />

                <RadioButton
                    android:id="@+id/profile_gender_female"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_female" />

                <RadioButton
                    android:id="@+id/profile_gender_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_other" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_personality"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <RadioGroup
                android:id="@+id/profile_personality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <RadioButton
                    android:id="@+id/profile_personality_warm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_warm" />

                <RadioButton
                    android:id="@+id/profile_personality_tutor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_tutor" />

                <RadioButton
                    android:id="@+id/profile_personality_concise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_concise" />

                <RadioButton
                    android:id="@+id/profile_personality_witty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_witty" />

                <RadioButton
                    android:id="@+id/profile_personality_strict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_strict" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
