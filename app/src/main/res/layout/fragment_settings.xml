<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mocha_header_bg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="@color/mocha_brown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_m">

            <!-- Appearance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <RadioGroup
                android:id="@+id/settings_theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <RadioButton
                    android:id="@+id/settings_theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_theme_system"
                    android:textAppearance="@style/TextAppearance.Mocha.Body" />

                <RadioButton
                    android:id="@+id/settings_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_theme_light"
                    android:textAppearance="@style/TextAppearance.Mocha.Body" />

                <RadioButton
                    android:id="@+id/settings_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_theme_dark"
                    android:textAppearance="@style/TextAppearance.Mocha.Body" />
            </RadioGroup>

            <!-- AI gateway -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_backend"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/settings_backend_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/settings_backend_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="@color/mocha_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_save"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_reset"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_backend_test"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backend_test" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_backend_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_backend_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <!-- Backup -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_backup"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_export"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_export" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_import"
                    style="@style/Widget.Mocha.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_import" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_backup_never"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_backup_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/settings_backup_reminder"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <!-- Privacy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_privacy"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:text="@string/settings_privacy_body"
                android:textAppearance="@style/TextAppearance.Mocha.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/settings_about"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
