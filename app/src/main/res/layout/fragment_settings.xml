<?xml version="1.0" encoding="utf-8"?>
<!-- The settings hub. Four rooms, not one long corridor: everything used to live on a single
     scroll, which made the theme radio and the destructive Import button neighbours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaHeaderBg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_gutter"
        android:paddingEnd="@dimen/content_gutter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:id="@+id/settings_open_appearance"
                style="@style/Widget.Mocha.SettingsGroup">

                <ImageView
                    android:layout_width="@dimen/settings_group_icon"
                    android:layout_height="@dimen/settings_group_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_palette" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_appearance"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_appearance_summary"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_open_ai"
                style="@style/Widget.Mocha.SettingsGroup">

                <ImageView
                    android:layout_width="@dimen/settings_group_icon"
                    android:layout_height="@dimen/settings_group_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_chat"
                    app:tint="?attr/modeModifyInk" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backend"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_ai_summary"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_open_backup"
                style="@style/Widget.Mocha.SettingsGroup">

                <ImageView
                    android:layout_width="@dimen/settings_group_icon"
                    android:layout_height="@dimen/settings_group_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_backup" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backup"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <TextView
                        android:id="@+id/settings_backup_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backup_never"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_open_about"
                style="@style/Widget.Mocha.SettingsGroup">

                <ImageView
                    android:layout_width="@dimen/settings_group_icon"
                    android:layout_height="@dimen/settings_group_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_privacy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_privacy"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_privacy_summary"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/settings_about"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
