<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_state_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_l"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/list_state_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/mocha_brown" />

    <TextView
        android:id="@+id/list_state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:maxWidth="@dimen/reader_max_width"
        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/list_state_retry"
        style="@style/Widget.Mocha.ToolbarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/action_retry"
        android:visibility="gone" />
</LinearLayout>
