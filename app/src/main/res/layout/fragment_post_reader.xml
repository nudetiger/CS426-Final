<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_island"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/reader_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <!-- Back walks the trail one post at a time; this leaves it. Eleven wiki-links deep,
             going home was eleven taps, which is what made following a link feel expensive. -->
        <ImageButton
            android:id="@+id/reader_home"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_home"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="?attr/mochaBrown" />

        <ImageButton
            android:id="@+id/reader_graph"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_show_graph"
            android:src="@drawable/ic_branch" />

        <ImageButton
            android:id="@+id/reader_favorite"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_favorite"
            android:src="@drawable/ic_star_border" />

        <ImageButton
            android:id="@+id/reader_edit"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_edit"
            android:src="@drawable/ic_edit" />
    </LinearLayout>

    <!-- Branch reading session. Present only while walking a branch, and the one control
         that moves between posts without touching the back stack. -->
    <LinearLayout
        android:id="@+id/reader_branch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mochaCreamDark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_xs"
        android:visibility="gone">

        <TextView
            android:id="@+id/reader_branch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Caption"
            android:textColor="?attr/mochaBrown" />

        <ImageButton
            android:id="@+id/reader_branch_outline"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/branch_outline"
            android:src="@drawable/ic_folder" />

        <ImageButton
            android:id="@+id/reader_branch_prev"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/branch_prev"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/reader_branch_next"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/branch_next"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/reader_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reader_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:textColor="?attr/mochaBrown" />

                <TextView
                    android:id="@+id/reader_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <!-- What this post expects you to have read, before the post itself. Hidden
                     outright when nothing is required, which is most posts. -->
                <LinearLayout
                    android:id="@+id/reader_prereq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_s"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/reader_prereq_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reader_prereq"
                        android:textAppearance="@style/TextAppearance.Mocha.Section"
                        android:textColor="?attr/mochaBrown" />

                    <TextView
                        android:id="@+id/reader_prereq_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

                    <!-- The same meter Browse draws over a folder, so the colours only ever
                         have to be learned once. -->
                    <include
                        android:id="@+id/reader_prereq_meter"
                        layout="@layout/view_status_meter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />

                    <LinearLayout
                        android:id="@+id/reader_prereq_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/reader_tags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/reader_terms_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/reader_terms"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/reader_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/reader_dictionary_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/reader_dictionary"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:textColor="?attr/mochaBrown" />

                <TextView
                    android:id="@+id/reader_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:maxWidth="@dimen/reader_max_width"
                    android:textAppearance="@style/TextAppearance.Mocha.Body"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:id="@+id/reader_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reader_up_next"
                        android:textAppearance="@style/TextAppearance.Mocha.Caption" />

                    <TextView
                        android:id="@+id/reader_next_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Mocha.Section"
                        android:textColor="?attr/mochaBrown" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reader_resources_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_references"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_resources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Posts filed under this one. Above backlinks because they are part of
                     this article rather than references to it. -->
                <TextView
                    android:id="@+id/reader_children_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_sub_posts"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_children"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/reader_backlinks_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_backlinks"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_backlinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/reader_related_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_related"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
