<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mocha_header_bg"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s">

        <ImageButton
            android:id="@+id/reader_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mocha.Title"
            android:textColor="@color/mocha_brown" />

        <ImageButton
            android:id="@+id/reader_graph"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_show_graph"
            android:src="@drawable/ic_branch" />

        <ImageButton
            android:id="@+id/reader_favorite"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_favorite"
            android:src="@drawable/ic_star_border" />

        <ImageButton
            android:id="@+id/reader_edit"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_edit"
            android:src="@drawable/ic_edit" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/reader_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reader_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:textColor="@color/mocha_brown" />

                <TextView
                    android:id="@+id/reader_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/reader_tags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/reader_terms_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/reader_terms"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/reader_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/reader_dictionary_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/reader_dictionary"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:textColor="@color/mocha_brown" />

                <TextView
                    android:id="@+id/reader_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:maxWidth="@dimen/reader_max_width"
                    android:textAppearance="@style/TextAppearance.Mocha.Body"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/reader_resources_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_references"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_resources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/reader_backlinks_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_backlinks"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_backlinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/reader_related_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/reader_related"
                    android:textAppearance="@style/TextAppearance.Mocha.Section"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reader_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
