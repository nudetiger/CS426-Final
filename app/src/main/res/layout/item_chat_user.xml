<?xml version="1.0" encoding="utf-8"?>
<!-- The user bubble hugs the end edge, so only the start side carries a gutter.
     Start/End keep that correct in RTL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="@dimen/chat_bubble_gutter"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs"
    tools:ignore="RtlSymmetry">


    <!-- Which mode this exchange was sent in. Tinted at bind time, so scrolling back through
         a conversation shows what each turn was asking for without reading a word of it. -->
    <TextView
        android:id="@+id/bubble_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.Mocha.Caption"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_user"
        android:maxWidth="@dimen/chat_bubble_max"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Mocha.Body"
        android:textColor="?attr/mochaOnPrimary" />
</LinearLayout>
