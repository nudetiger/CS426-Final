<?xml version="1.0" encoding="utf-8"?>
<!-- The user bubble hugs the end edge, so only the start side carries a gutter.
     Start/End keep that correct in RTL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="@dimen/chat_bubble_gutter"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs"
    tools:ignore="RtlSymmetry">

    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_user"
        android:maxWidth="@dimen/chat_bubble_max"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Mocha.Body"
        android:textColor="@color/mocha_on_primary" />
</LinearLayout>
