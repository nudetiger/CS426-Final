<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_l">

    <TextView
        android:id="@+id/create_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browse_create_title"
        android:textAppearance="@style/TextAppearance.Mocha.Title"
        android:textColor="@color/mocha_brown" />

    <RadioGroup
        android:id="@+id/create_type_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/create_type_branch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/browse_type_branch" />

        <RadioButton
            android:id="@+id/create_type_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/browse_type_folder" />

        <RadioButton
            android:id="@+id/create_type_post"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="@dimen/touch_target"
            android:text="@string/browse_type_post" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/create_title_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:hint="@string/node_title_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/create_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
