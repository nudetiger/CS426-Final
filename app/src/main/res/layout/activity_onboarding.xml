<?xml version="1.0" encoding="utf-8"?>
<!-- First launch. One scroll, four questions, one button — the shape every productivity app
     uses for this, because nothing here is worth a carousel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_gutter"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_brand_learning"
                    android:textAppearance="@style/TextAppearance.Mocha.Brand" />

                <ImageView
                    android:layout_width="@dimen/brand_mark"
                    android:layout_height="@dimen/brand_mark"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_coffee" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_brand_mocha"
                    android:textAppearance="@style/TextAppearance.Mocha.Brand"
                    android:textColor="?attr/mochaBrownDeep" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/onboarding_subtitle"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/onboarding_name"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/onboarding_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/onboarding_name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="?attr/mochaTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/onboarding_phone"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/onboarding_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/onboarding_phone_hint"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="?attr/mochaTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/onboarding_birth_year"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <EditText
                android:id="@+id/onboarding_birth_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:hint="@string/onboarding_birth_year_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:minHeight="@dimen/touch_target"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Mocha.Body"
                android:textColorHint="?attr/mochaTextSecondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/onboarding_birth_year_help"
                android:textAppearance="@style/TextAppearance.Mocha.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/onboarding_gender"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <RadioGroup
                android:id="@+id/onboarding_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <RadioButton
                    android:id="@+id/onboarding_gender_male"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_male" />

                <RadioButton
                    android:id="@+id/onboarding_gender_female"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_female" />

                <RadioButton
                    android:id="@+id/onboarding_gender_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_gender_other" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/onboarding_preferences"
                android:textAppearance="@style/TextAppearance.Mocha.Section" />

            <RadioGroup
                android:id="@+id/onboarding_personality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <RadioButton
                    android:id="@+id/onboarding_personality_warm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_warm" />

                <RadioButton
                    android:id="@+id/onboarding_personality_tutor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_tutor" />

                <RadioButton
                    android:id="@+id/onboarding_personality_concise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_concise" />

                <RadioButton
                    android:id="@+id/onboarding_personality_witty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_witty" />

                <RadioButton
                    android:id="@+id/onboarding_personality_strict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/settings_personality_strict" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned, so the one way forward is never scrolled off the bottom of a long form. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/onboarding_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_gutter"
        android:layout_marginEnd="@dimen/content_gutter"
        android:layout_marginBottom="@dimen/space_m"
        android:minHeight="@dimen/touch_target"
        android:text="@string/onboarding_start" />
</LinearLayout>
