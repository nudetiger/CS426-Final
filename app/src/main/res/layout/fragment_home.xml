<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mochaCream"
    android:orientation="vertical">

    <!-- The wordmark, centred, with the cup set between the two words. No greeting and no
         library count: neither told the user anything they could act on, and both pulled the
         eye away from the one thing this header is for. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_island"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/content_gutter"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_brand_learning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_brand_learning"
                android:textAppearance="@style/TextAppearance.Mocha.Brand" />

            <ImageView
                android:id="@+id/home_brand_mark"
                android:layout_width="@dimen/brand_mark"
                android:layout_height="@dimen/brand_mark"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:contentDescription="@null"
                android:src="@drawable/ic_coffee" />

            <TextView
                android:id="@+id/home_brand_mocha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_brand_mocha"
                android:textAppearance="@style/TextAppearance.Mocha.Brand"
                android:textColor="?attr/mochaBrownDeep" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_horizontal"
            android:text="@string/home_tagline"
            android:textAppearance="@style/TextAppearance.Mocha.Caption" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_s">

                <!-- The graph, favourites, dictionary and tag index have no bottom-nav slot,
                     so Home is their only entry point. Two rows of two, not a scrolling strip:
                     every destination is on screen and none of them has to be hunted for. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter">

                    <LinearLayout
                        android:id="@+id/home_action_graph"
                        style="@style/Widget.Mocha.QuickAction"
                        android:layout_marginEnd="@dimen/space_s">

                        <ImageView
                            style="@style/Widget.Mocha.QuickActionIcon"
                            android:src="@drawable/ic_graph" />

                        <TextView
                            style="@style/Widget.Mocha.QuickActionLabel"
                            android:text="@string/graph_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_action_favorites"
                        style="@style/Widget.Mocha.QuickAction">

                        <ImageView
                            style="@style/Widget.Mocha.QuickActionIcon"
                            android:src="@drawable/ic_star" />

                        <TextView
                            style="@style/Widget.Mocha.QuickActionLabel"
                            android:text="@string/favorites_title" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter">

                    <LinearLayout
                        android:id="@+id/home_action_dictionary"
                        style="@style/Widget.Mocha.QuickAction"
                        android:layout_marginEnd="@dimen/space_s">

                        <ImageView
                            style="@style/Widget.Mocha.QuickActionIcon"
                            android:src="@drawable/ic_dictionary" />

                        <TextView
                            style="@style/Widget.Mocha.QuickActionLabel"
                            android:text="@string/dictionary_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_action_tags"
                        style="@style/Widget.Mocha.QuickAction">

                        <ImageView
                            style="@style/Widget.Mocha.QuickActionIcon"
                            android:src="@drawable/ic_tag" />

                        <TextView
                            style="@style/Widget.Mocha.QuickActionLabel"
                            android:text="@string/tags_title" />
                    </LinearLayout>
                </LinearLayout>

                <!-- How the whole library stands, in the same bar Browse uses per folder. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/content_gutter"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginEnd="@dimen/content_gutter"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:text="@string/home_section_progress"
                        android:textAppearance="@style/TextAppearance.Mocha.Section" />

                    <include
                        android:id="@+id/home_meter"
                        layout="@layout/view_status_meter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_continue_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_continue"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_continue_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_continue_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_continue_empty"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_recents_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_recents"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_recents_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_favorites_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_chevron"
                    android:drawablePadding="@dimen/space_xs"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_favorites"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_favorites_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_favorites_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_favorites_empty"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_branches_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_branches"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_branches_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
