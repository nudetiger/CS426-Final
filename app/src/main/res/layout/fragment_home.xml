<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mocha_header_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/content_gutter"
        android:paddingBottom="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_brand"
                    android:textAppearance="@style/TextAppearance.Mocha.Title"
                    android:textColor="@color/mocha_brown" />

                <TextView
                    android:id="@+id/home_tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tagline"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <TextView
                    android:id="@+id/home_library_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick actions. The graph, favourites, dictionary and tag index have no bottom-nav
         slot, so Home is their only entry point; it scrolls so the row never clips. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/content_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_action_graph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:background="@drawable/bg_feature_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:text="@string/graph_title"
                android:textAppearance="@style/TextAppearance.Mocha.Section"
                android:textColor="@color/mocha_brown" />

            <TextView
                android:id="@+id/home_action_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:background="@drawable/bg_feature_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:text="@string/favorites_title"
                android:textAppearance="@style/TextAppearance.Mocha.Section"
                android:textColor="@color/mocha_brown" />

            <TextView
                android:id="@+id/home_action_dictionary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:background="@drawable/bg_feature_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:text="@string/dictionary_title"
                android:textAppearance="@style/TextAppearance.Mocha.Section"
                android:textColor="@color/mocha_brown" />

            <TextView
                android:id="@+id/home_action_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:text="@string/tags_title"
                android:textAppearance="@style/TextAppearance.Mocha.Section"
                android:textColor="@color/mocha_brown" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_s">

                <TextView
                    android:id="@+id/home_continue_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_continue"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_continue_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_continue_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_continue_empty"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_recents_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_recents"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_recents_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_favorites_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_chevron"
                    android:drawablePadding="@dimen/space_xs"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_favorites"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_favorites_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />

                <TextView
                    android:id="@+id/home_favorites_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_favorites_empty"
                    android:textAppearance="@style/TextAppearance.Mocha.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_branches_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/content_gutter"
                    android:paddingBottom="@dimen/space_s"
                    android:text="@string/home_section_branches"
                    android:textAppearance="@style/TextAppearance.Mocha.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_branches_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/content_gutter"
                    android:paddingEnd="@dimen/content_gutter" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/list_state"
            layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
