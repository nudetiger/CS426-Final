<?xml version="1.0" encoding="utf-8"?>
<!-- Every palette token the app draws with, declared as a theme attribute.

     Layouts, drawables and colour selectors reference "?attr/mochaBrown" rather than
     "@color/mocha_brown" so that a whole palette can be swapped by setting one theme on
     the Activity. values/colors.xml (+ values-night) still holds the default Mocha values;
     the named palettes in values/colors_palettes.xml supply the rest. -->
<resources>
    <attr name="mochaCream" format="color|reference" />
    <attr name="mochaCreamDark" format="color|reference" />
    <attr name="mochaHeaderBg" format="color|reference" />
    <attr name="mochaBrown" format="color|reference" />
    <attr name="mochaBrownDeep" format="color|reference" />
    <attr name="mochaSage" format="color|reference" />
    <attr name="mochaTaupe" format="color|reference" />
    <attr name="mochaSurface" format="color|reference" />
    <attr name="mochaSurfaceElevated" format="color|reference" />
    <attr name="mochaTextPrimary" format="color|reference" />
    <attr name="mochaTextSecondary" format="color|reference" />
    <attr name="mochaOnPrimary" format="color|reference" />
    <attr name="mochaDivider" format="color|reference" />
    <attr name="mochaError" format="color|reference" />
    <attr name="mochaRowEven" format="color|reference" />
    <attr name="mochaRowOdd" format="color|reference" />
    <attr name="mochaFavorite" format="color|reference" />
    <attr name="statusNoneInk" format="color|reference" />
    <attr name="statusNoneWash" format="color|reference" />
    <attr name="statusReadingInk" format="color|reference" />
