<?xml version="1.0" encoding="utf-8"?>
<!-- The named palettes. Each one only re-points the palette attributes declared in
     attrs_theme.xml — every layout, drawable and colour selector already reads them through
     "?attr/", so nothing else in the app has to know a palette exists.

     All three are dark schemes, so AppTheme also forces MODE_NIGHT_YES when one is picked:
     the framework's own widget defaults (dialog scrims, spinner popups, text-selection
     handles) come from the DayNight parent, and light defaults on a Catppuccin ground look
     exactly as broken as they sound. -->
<resources>

    <!-- Rose Pine (main) -->
    <style name="Theme.LearningMocha.RosePine" parent="Theme.Mocha.Base">
        <item name="android:windowLightStatusBar">false</item>
        <item name="mochaCream">@color/rp_cream</item>
        <item name="mochaCreamDark">@color/rp_cream_dark</item>
        <item name="mochaHeaderBg">@color/rp_header_bg</item>
        <item name="mochaBrown">@color/rp_brown</item>
        <item name="mochaBrownDeep">@color/rp_brown_deep</item>
        <item name="mochaSage">@color/rp_sage</item>
        <item name="mochaTaupe">@color/rp_taupe</item>
        <item name="mochaSurface">@color/rp_surface</item>
        <item name="mochaSurfaceElevated">@color/rp_surface_elevated</item>
        <item name="mochaTextPrimary">@color/rp_text_primary</item>
        <item name="mochaTextSecondary">@color/rp_text_secondary</item>
        <item name="mochaOnPrimary">@color/rp_on_primary</item>
        <item name="mochaDivider">@color/rp_divider</item>
        <item name="mochaError">@color/rp_error</item>
        <item name="mochaRowEven">@color/rp_row_even</item>
        <item name="mochaRowOdd">@color/rp_row_odd</item>
        <item name="mochaFavorite">@color/rp_favorite</item>
        <item name="statusNoneInk">@color/rp_status_none_ink</item>
        <item name="statusNoneWash">@color/rp_status_none_wash</item>
        <item name="statusReadingInk">@color/rp_status_reading_ink</item>
        <item name="statusReadingWash">@color/rp_status_reading_wash</item>
        <item name="statusProgressInk">@color/rp_status_progress_ink</item>
        <item name="statusProgressWash">@color/rp_status_progress_wash</item>
        <item name="statusFinishedInk">@color/rp_status_finished_ink</item>
        <item name="statusFinishedWash">@color/rp_status_finished_wash</item>
        <item name="typeBranchInk">@color/rp_type_branch_ink</item>
        <item name="typeBranchWash">@color/rp_type_branch_wash</item>
        <item name="typeFolderInk">@color/rp_type_folder_ink</item>
        <item name="typeFolderWash">@color/rp_type_folder_wash</item>
        <item name="typePostInk">@color/rp_type_post_ink</item>
        <item name="typePostWash">@color/rp_type_post_wash</item>
        <item name="modeAnswerInk">@color/rp_mode_answer_ink</item>
