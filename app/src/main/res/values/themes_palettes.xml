        <item name="modeAssistInk">@color/rp_mode_assist_ink</item>
        <item name="modeAssistWash">@color/rp_mode_assist_wash</item>
        <item name="markGoldInk">@color/rp_mark_gold_ink</item>
        <item name="markSkyInk">@color/rp_mark_sky_ink</item>
        <item name="markVioletInk">@color/rp_mark_violet_ink</item>
    </style>

