<?xml version="1.0" encoding="utf-8"?>
<!-- Top-level destinations match bottom_nav_menu ids so NavigationUI wires tabs for free. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cs426.learningmocha.ui.home.HomeFragment"
        android:label="@string/nav_home" />
    <fragment
        android:id="@+id/browseFragment"
        android:name="com.cs426.learningmocha.ui.browse.BrowseFragment"
        android:label="@string/nav_browse" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.cs426.learningmocha.ui.search.SearchFragment"
        android:label="@string/nav_search" />
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.cs426.learningmocha.ui.chat.ChatFragment"
        android:label="@string/nav_chat" />
    <!-- Settings is a hub of four screens. The actions are local rather than global: these
         are only reachable from the hub, so nothing else should be able to jump into them. -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.SettingsFragment"
        android:label="@string/nav_settings">
        <action
            android:id="@+id/action_settings_to_appearance"
            app:destination="@id/appearanceSettingsFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
        <action
            android:id="@+id/action_settings_to_profile"
            app:destination="@id/profileSettingsFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
        <action
            android:id="@+id/action_settings_to_ai"
            app:destination="@id/aiSettingsFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
        <action
            android:id="@+id/action_settings_to_backup"
            app:destination="@id/backupSettingsFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
        <action
            android:id="@+id/action_settings_to_about"
            app:destination="@id/aboutSettingsFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/appearanceSettingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.AppearanceSettingsFragment"
        android:label="@string/settings_appearance" />

    <fragment
        android:id="@+id/profileSettingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.ProfileSettingsFragment"
        android:label="@string/settings_you" />

    <fragment
        android:id="@+id/aiSettingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.AiSettingsFragment"
        android:label="@string/settings_backend" />

    <fragment
        android:id="@+id/backupSettingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.BackupSettingsFragment"
        android:label="@string/settings_backup" />

    <fragment
        android:id="@+id/aboutSettingsFragment"
        android:name="com.cs426.learningmocha.ui.settings.AboutSettingsFragment"
        android:label="@string/settings_privacy" />

    <fragment
        android:id="@+id/postReaderFragment"
        android:name="com.cs426.learningmocha.ui.reader.PostReaderFragment"
        android:label="@string/reader_title">
        <argument
            android:name="postId"
            app:argType="long" />
        <!-- Set when the post was opened as part of "Read this branch"; 0 means a normal
             open. It is a nav argument rather than session state so it survives process
             death with the post it belongs to. -->
        <argument
            android:name="branchId"
            android:defaultValue="0L"
            app:argType="long" />
        <action
            android:id="@+id/action_reader_to_editor"
            app:destination="@id/postEditorFragment"
            app:enterAnim="@anim/nav_enter"
            app:exitAnim="@anim/nav_exit"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/postEditorFragment"
        android:name="com.cs426.learningmocha.ui.editor.PostEditorFragment"
        android:label="@string/editor_title">
        <argument
            android:name="postId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="parentId"
            android:defaultValue="-1L"
            app:argType="long" />
        <!-- Set when Browse already asked for a title, so a new post opens pre-filled. -->
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.cs426.learningmocha.ui.home.FavoritesFragment"
        android:label="@string/favorites_title" />
    <fragment
        android:id="@+id/dictionaryFragment"
        android:name="com.cs426.learningmocha.ui.dictionary.DictionaryFragment"
        android:label="@string/dictionary_title" />
    <fragment
        android:id="@+id/tagDetailFragment"
        android:name="com.cs426.learningmocha.ui.search.TagDetailFragment"
        android:label="@string/tag_title">
        <argument
            android:name="tagId"
            app:argType="long" />
    </fragment>

    <!-- Knowledge graph: whole library, or the neighbourhood of one post when
         focusPostId is set (0 = whole library). -->
    <fragment
        android:id="@+id/graphFragment"
        android:name="com.cs426.learningmocha.ui.graph.GraphFragment"
        android:label="@string/graph_title">
        <argument
            android:name="focusPostId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/tagsFragment"
        android:name="com.cs426.learningmocha.ui.search.TagsFragment"
        android:label="@string/tags_title" />

    <fragment
        android:id="@+id/chatConversationFragment"
        android:name="com.cs426.learningmocha.ui.chat.ChatConversationFragment"
        android:label="@string/nav_chat">
        <argument
            android:name="sessionId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/reviewChangesFragment"
        android:name="com.cs426.learningmocha.ui.review.ReviewChangesFragment"
        android:label="@string/review_title">
        <argument
            android:name="messageId"
            app:argType="long" />
    </fragment>

    <!-- Every destination change shares one 180 ms fade-and-drift set (res/anim/nav_*). -->
    <action
        android:id="@+id/action_global_open_post"
        app:destination="@id/postReaderFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_edit_post"
        app:destination="@id/postEditorFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_favorites"
        app:destination="@id/favoritesFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_dictionary"
        app:destination="@id/dictionaryFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_tag"
        app:destination="@id/tagDetailFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_graph"
        app:destination="@id/graphFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_tags"
        app:destination="@id/tagsFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_chat_conversation"
        app:destination="@id/chatConversationFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
    <action
        android:id="@+id/action_global_review_changes"
        app:destination="@id/reviewChangesFragment"
        app:enterAnim="@anim/nav_enter"
        app:exitAnim="@anim/nav_exit"
        app:popEnterAnim="@anim/nav_pop_enter"
        app:popExitAnim="@anim/nav_pop_exit" />
</navigation>
