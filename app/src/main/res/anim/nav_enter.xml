<?xml version="1.0" encoding="utf-8"?>
<!-- Shared destination transition: a short fade with a small forward drift.
     The system's animator duration scale still applies, so users who turn
     animations off in Developer options / accessibility get none. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad">

    <alpha
        android:duration="180"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <translate
        android:duration="180"
        android:fromXDelta="4%p"
        android:toXDelta="0%p" />
</set>
